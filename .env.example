# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RESEND_API_KEY: Required for sending transactional emails (order confirmations, invoices, bookings, and alerts) via Resend.
# AI Studio automatically injects this at runtime from user secrets.
RESEND_API_KEY="MY_RESEND_API_KEY"

# RESEND_FROM_EMAIL: Sender email address verified in Resend (default: Giriraj Power <team@girirajpower.in> or Giriraj Power <onboarding@resend.dev>)
RESEND_FROM_EMAIL="Giriraj Power <team@girirajpower.in>"

# RESEND_INBOUND_EMAIL: Official email receiving inbound inquiries and customer support messages
RESEND_INBOUND_EMAIL="team@girirajpower.in"

# SUPABASE CONFIGURATION:
# VITE_SUPABASE_URL: Supabase Project API URL
VITE_SUPABASE_URL="https://iffdkhzctkbglmvaayeh.supabase.co"
# VITE_SUPABASE_ANON_KEY: Supabase Public Anonymous API Key
VITE_SUPABASE_ANON_KEY="sb_publishable_C7DzW73hItwOaxr9R4Z2dw_HtjCqHaS"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

